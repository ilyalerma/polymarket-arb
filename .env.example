# Scanner defaults
PM_MIN_NET_EDGE=0.002
PM_MAX_TRADE_USD=100
PM_MARKET_LIMIT=50
PM_MIN_LIQUIDITY=5000
PM_POLL_INTERVAL_MS=3000

# Dry-run trade latency benchmark (no orders execute)
PM_BENCHMARK=1 PM_BENCHMARK_ITERATIONS=20 ./build/polymarket-arb --benchmark lol-kt-dk-2026-09-04-game4

