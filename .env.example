# Scanner defaults
PM_MIN_NET_EDGE=0.002
PM_MAX_TRADE_USD=100
PM_POLL_INTERVAL_MS=2000
# PM_DISABLE_WS=1          # fallback: poll CLOB REST for books (slow)
# PM_POLL_INTERVAL_MS=2000 # gamma market-list refresh interval in WS mode

# LoL event discovery (default when no slug is passed)
PM_LOL_DISCOVER=1
PM_SERIES_SLUG=league-of-legends
PM_EVENT_LIMIT=30
# PM_LOL_LIVE_ONLY=1

# Watch a single match (moneyline + all game winners):
# PM_EVENT_SLUG=lol-kt-dk-2026-09-04

# Or watch a single market:
# PM_MARKET_SLUG=lol-kt-dk-2026-09-04-game4

# Skip market types:
# PM_SKIP_MONEYLINE=1
# PM_SKIP_GAME_WINNERS=1

# Game progression (default: only scan the current unresolved game)
# PM_SCAN_ALL_GAMES=1
# PM_GAME_LOSER_ASK_MAX=0.01
# PM_GAME_WINNER_BID_MIN=0.99

# Dry-run trade latency benchmark (no orders execute)
# PM_BENCHMARK_ITERATIONS=100 ./build/polymarket-arb --benchmark <market-slug>
# PM_BENCHMARK_ITERATIONS=100 ./build/polymarket-arb --benchmark-book <market-slug>

# Optional: include real L2 auth timing (still rejects stub order)
# PM_API_KEY=... PM_API_SECRET=... PM_API_PASSPHRASE=... PM_WALLET_ADDRESS=...
